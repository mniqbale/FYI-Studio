// FYI Studio Database Schema — Job Ledger & Telemetry
// Mirrors the authoritative Contracts v1.1 SQL in `.ai/architecture/contracts.md` (§1.4, §1.6).
// snake_case column mapping enforced via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

model Job {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.VarChar(255)
  recipe_id         String   @db.VarChar(255)
  status            JobStatus @default(PENDING)
  current_step_index Int     @default(0)
  recipe_snapshot   Json
  artifacts         Json?    @default("{}")
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  telemetry Telemetry[]

  @@index([tenant_id, status], name: "idx_jobs_tenant_status")
  @@index([created_at], name: "idx_jobs_created_at")
  @@map("jobs")
}

model Telemetry {
  id             Int      @id @default(autoincrement())
  job_id         String   @db.Uuid
  execution_id   String   @db.VarChar(255)
  worker_id      String   @db.VarChar(255)
  worker_version String   @db.VarChar(50)
  provider       String?  @db.VarChar(50)
  model          String?  @db.VarChar(50)
  tokens_in      Int?
  tokens_out     Int?
  seconds        Int?
  cost           Decimal? @db.Decimal(10, 6)
  duration_ms    Int?
  started_at     DateTime @db.Timestamptz(6)
  finished_at    DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id], name: "idx_telemetry_job")
  @@index([worker_id, created_at], name: "idx_telemetry_worker")
  @@index([provider, model, created_at], name: "idx_telemetry_provider")
  @@map("telemetry")
}

// ---- AI Platform Foundation (Milestone 2 / ADR-0007) ----

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// Status of a model in the Model Registry.
enum ModelStatus {
  ACTIVE
  DEPRECATED
  DISABLED
}

/// A user connection to an AI provider (BYOAI). Stores only a key_ref,
/// never the API key material itself (per ADR-0007 security requirement).
model ProviderConnection {
  id           String           @id @default(uuid()) @db.Uuid
  provider     String           @db.VarChar(100) // e.g. "openai", "anthropic", "gemini"
  scope        String           @default("default") @db.VarChar(100) // tenant scope
  key_ref      String           @db.VarChar(255) // pointer to secret storage, not the key
  status       ConnectionStatus @default(CONNECTED)
  health_error String?          @db.VarChar(255)
  quota_limit  Decimal?         @db.Decimal(10, 2)
  quota_used   Decimal?         @db.Decimal(10, 2)
  connected_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([provider, scope], name: "idx_provider_scope_unique")
  @@map("provider_connections")
}

/// Catalog of AI models available in the platform, with capability metadata.
model ModelRegistry {
  id             String      @id @default(uuid()) @db.Uuid
  provider       String      @db.VarChar(100)
  model          String      @db.VarChar(100)
  version        String?     @db.VarChar(50)
  pricing_per_1k_tokens Decimal? @db.Decimal(10, 6)
  context_window Int?
  status         ModelStatus @default(ACTIVE)
  capabilities   Json        @default("[]") // ["reasoning","vision",...]
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([provider, model], name: "idx_model_provider_model_unique")
  @@map("model_registry")
}

/// The set of capabilities ModelGate v2 can route by (ADR-0007).
model CapabilityRegistry {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100) // e.g. "reasoning", "vision", "image"
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("capability_registry")
}

// ---- Knowledge Layer + Memory (Milestone 4) ----
// Per MVP architecture: the "flattened brain" is a PostgreSQL `tenant_context`
// table (no vector DB for MVP). Brand voice + constraints are injected into
// worker prompts via the Context Assembly Engine.

/// Tenant Knowledge Base — brand voice, style guides, verified facts,
/// asset library pointers, and per-channel constraints.
model TenantContext {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @unique @db.VarChar(255) // Channel/Brand ID
  brand_voice        String?  @db.Text
  language           String?  @default("en") @db.VarChar(50)
  style_guide        String?  @db.Text
  verified_facts     Json?    @default("[]")
  asset_library      Json?    @default("[]") // S3 pointers only (Reference-Based Data Plane)
  forbidden_terms    Json?    @default("[]")
  constraints        Json?    @default("{}") // per-channel constraints (duration, tone, etc.)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  @@map("tenant_context")
}

/// Memory Layer (MVP) — historical performance + edits per tenant, used to
/// inform future context assembly. JSONB content is schema-flexible for MVP.
model MemoryEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.VarChar(255)
  job_id      String?  @db.Uuid
  kind        String   @db.VarChar(50) // "performance" | "edit" | "analytics"
  content     Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, kind], name: "idx_memory_tenant_kind")
  @@index([tenant_id, created_at], name: "idx_memory_tenant_created")
  @@map("memory_entries")
}

// ---- Multi-Tenant (Milestone 6) ----
// MVP-scoped: Tenant Policy — per-tenant model preference + cost quota.
// A/B testing, Worker Registry v2, dashboard deferred to post-MVP.

/// Per-tenant policy: model preferences by capability + cost quota.
/// Enforces tenant isolation and per-tenant model selection / budget.
model TenantPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @unique @db.VarChar(255) // Channel/Brand ID
  // Per-capability model preference, e.g. { "research:real": { provider, model } }
  model_preferences Json? @default("{}")
  // Cost quota in USD; null = unlimited. Cost is tracked via telemetry.
  cost_quota    Decimal? @db.Decimal(12, 6)
  // Optional flag to disable a tenant (reject new jobs).
  enabled       Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@map("tenant_policies")
}

// ---- Social Publish & Scheduling (Milestone 10 / ADR-0008) ----

/// A connected social account per tenant. Stores a token_ref (never the OAuth
/// token material — ADR-0006/0007 secret pattern).
model SocialAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.VarChar(255)
  platform      String   @db.VarChar(50) // 'youtube' | 'facebook' | 'instagram' | 'tiktok'
  display_name  String   @db.VarChar(255)
  account_ref   String   @db.VarChar(255) // platform channel/account id
  token_ref     String   @db.Text // encrypted OAuth bundle (AES-256-GCM + base64url can exceed 255 chars)
  enabled       Boolean  @default(true)
  connected_at  DateTime @default(now()) @db.Timestamptz(6)
  last_sync_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  schedules ScheduledPublish[]

  @@index([tenant_id, platform], name: "idx_social_account_tenant_platform")
  @@map("social_accounts")
}

/// A scheduled publication of a job's content to a social account.
/// Status machine: scheduled -> publishing -> published | failed (ADR-0008).
model ScheduledPublish {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.VarChar(255)
  job_id            String   @db.Uuid
  social_account_id String   @db.Uuid
  scheduled_at      DateTime @db.Timestamptz(6)
  status            String   @default("scheduled") // scheduled | publishing | published | failed
  platform_response Json?    // { videoId, url, error } from the platform
  attempts          Int      @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)

  social_account SocialAccount @relation(fields: [social_account_id], references: [id], onDelete: Cascade)

  @@index([status, scheduled_at], name: "idx_scheduled_publish_status_time")
  @@index([job_id], name: "idx_scheduled_publish_job")
  @@map("scheduled_publishes")
}

// ---- Platform Analytics & Revenue (Milestone 11 / ADR-0009) ----

/// Per-video content performance snapshot (views, likes, comments, watch time).
model PlatformMetric {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.VarChar(255)
  video_id         String   @db.VarChar(255)
  platform         String   @default("youtube") @db.VarChar(50)
  snapshot_date    DateTime @db.Timestamptz(6) // date-only (start of day) key
  views            Int      @default(0)
  likes            Int      @default(0)
  comments         Int      @default(0)
  watch_time_minutes Int    @default(0)
  retention_pct    Float?
  fetched_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([video_id, platform, snapshot_date], name: "idx_platform_metric_unique")
  @@index([tenant_id, snapshot_date], name: "idx_platform_metric_tenant_time")
  @@map("platform_metrics")
}

/// YouTube (or platform) revenue per video per period.
model VideoRevenue {
  id        String   @id @default(uuid()) @db.Uuid
  tenant_id String   @db.VarChar(255)
  video_id  String   @db.VarChar(255)
  platform  String   @default("youtube") @db.VarChar(50)
  revenue   Decimal  @db.Decimal(14, 6)
  currency  String   @default("USD") @db.VarChar(10)
  period    String   @db.VarChar(50) // e.g. "2026-08-06" or "2026-08"
  fetched_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([video_id, platform, period], name: "idx_video_revenue_unique")
  @@index([tenant_id], name: "idx_video_revenue_tenant")
  @@map("video_revenue")
}

/// Accounting log for each analytics ingestion run (quota ledger, ADR-0009).
model AnalyticsIngestionLog {
  id             String    @id @default(uuid()) @db.Uuid
  run_started_at DateTime  @default(now()) @db.Timestamptz(6)
  run_finished_at DateTime? @db.Timestamptz(6)
  units_consumed Int       @default(0)
  units_remaining Int      @default(10000)
  status         String    @default("running") // running | completed | failed | skipped_quota
  error          Json?

  @@index([run_started_at], name: "idx_ingestion_log_started")
  @@map("analytics_ingestion_log")
}

