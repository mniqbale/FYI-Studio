{
  "name": "fyi-studio",
  "version": "1.0.0",
  "private": true,
  "description": "FYI Studio — AI Operating System for Distributed Media Production (Sprint 1: Skeleton Run)",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./workers/**\" --filter \"./services/**\" run build",
    "clean": "pnpm -r --filter \"./packages/**\" --filter \"./workers/**\" --filter \"./services/**\" run clean",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./workers/**\" --filter \"./services/**\" --filter \"./tests\" run typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "infra:logs": "docker compose logs -f",
    "start-skeleton": "tsx packages/cli/src/trigger-run.ts",
    "dashboard": "tsx services/dashboard/src/index.ts",
    "dashboard:dev": "tsx watch services/dashboard/src/index.ts",
    "dashboard:build": "pnpm --filter @fyi/dashboard run build",
    "dashboard:typecheck": "pnpm --filter @fyi/dashboard run typecheck",
    "dashboard:seed": "tsx services/dashboard/scripts/seed-test-job.ts",
    "publish:scheduler": "tsx services/publish/src/index.ts",
    "publish:worker": "tsx workers/publish-real/src/index.ts",
    "publish:seed": "tsx services/dashboard/scripts/seed-publish-demo.ts",
    "analytics:ingest": "tsx services/analytics-ingest/scripts/run-cycle-check.ts",
    "analytics:ingest:seed": "tsx services/analytics-ingest/scripts/seed-published.ts",
    "test:e2e": "vitest run tests/e2e/skeleton-run.test.ts",
    "test:e2e:watch": "vitest tests/e2e/skeleton-run.test.ts",
    "fyi": "tsx packages/cli/src/provider.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.5",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
