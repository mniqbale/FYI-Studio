# FYI Studio — local development environment

# --- PostgreSQL (Job Ledger — source of truth) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fyi_studio

# --- Redis (BullMQ job queue) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Logging ---
LOG_LEVEL=info
