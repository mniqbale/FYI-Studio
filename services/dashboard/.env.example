# services/dashboard — local configuration
# Copy to .env and adjust as needed.

# HTTP server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Job Ledger (PostgreSQL) — same as root .env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fyi_studio

# Media root (where workers write artifacts). Defaults to /tmp/fyi-studio.
FYI_MEDIA_ROOT=/tmp/fyi-studio
