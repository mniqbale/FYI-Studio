{
  "name": "@fyi/dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "FYI Studio Dashboard — read-only web UI over the Job Ledger (Milestone 8 / Sprint 7)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed:test": "tsx scripts/seed-test-job.ts",
    "test": "vitest run tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^7.0.0",
    "@fyi/analytics": "workspace:1.0.0",
    "@fyi/database": "workspace:1.0.0",
    "@fyi/knowledge": "workspace:1.0.0",
    "@fyi/media": "workspace:1.0.0",
    "@fyi/platform": "workspace:1.0.0",
    "@fyi/publish": "workspace:1.0.0",
    "@fyi/supervisor": "workspace:1.0.0",
    "@fyi/utils": "workspace:1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
